# FormEdge — local environment template
# Copy to .env and adjust. Never commit the real .env.

# --- API ---
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@formedge.local
ADMIN_PASSWORD=admin1234

# --- Datastores (defaults match docker-compose) ---
DATABASE_URL=postgresql+psycopg://formedge:formedge@localhost:5432/formedge
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Scraping (polite defaults) ---
SCRAPE_USER_AGENT=FormEdgeBot/0.1 (personal project; contact: you@example.com)
SCRAPE_MIN_INTERVAL_SECONDS=2.0
RAW_HTML_CACHE_DIR=./raw_cache
MTC_FIXTURES_URL=https://www.mtcjockeyclub.com/form-guide/fixtures

# --- Weather (Open-Meteo, free) ---
WEATHER_ENABLED=true
RACE_VENUE_LAT=-20.2927
RACE_VENUE_LON=57.5025

# --- ML ---
ML_ARTIFACT_DIR=./ml_artifacts
ML_TEST_FRACTION=0.2

# --- Notifications (optional; core notification table works without) ---
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
